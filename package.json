{
  "name": "splunk-actionstack",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "node --test tests/*.test.mjs && python3 -m unittest discover -s tests -v",
    "package": "npm run build && python3 scripts/package_app.py",
    "format": "prettier --write frontend/src frontend/index.html vite.config.ts tsconfig.json package.json"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.0",
    "vite": "^7.3.0"
  }
}
